<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Assets/Editor/UIToolkit/SpriteFieldStyleSheet.uss?fileID=7433441132597879392&amp;guid=10c844fcedf5f3c4f81989ed8400e483&amp;type=3#SpriteFieldStyleSheet[UNSUPPORTED_IN_UI_BUILDER]" />
    <Style src="project://database/Assets/Editor/UIToolkit/GeneralStyleSheet.uss?fileID=7433441132597879392&amp;guid=b9cefa86d0ad2024fbc91b23bda38ac5&amp;type=3#GeneralStyleSheet" />
    <ui:GroupBox name="Box_Horizontal" style="flex-direction: row; justify-content: flex-start; align-self: auto; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; flex-wrap: nowrap; flex-shrink: 0; align-items: flex-start; padding-right: 3px; padding-bottom: 0;">
        <ui:GroupBox name="Box_Fields" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 3px; margin-bottom: 0; margin-left: 0; align-self: auto; overflow: visible; flex-wrap: nowrap; justify-content: flex-start; align-items: stretch; -unity-background-scale-mode: stretch-to-fill; flex-shrink: 1; flex-grow: 1; flex-direction: column;">
            <ui:TextField picking-mode="Ignore" label="Name" value="filler text" binding-path="m_ItemName" name="Field_Name" style="margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 2px;" />
            <ui:TextField picking-mode="Ignore" label="Description" value="a longer filler text, which can hopefully demonstrate multiple lines." multiline="true" name="Field_Description" binding-path="m_ItemDescription" password="false" auto-correction="false" readonly="false" is-delayed="false" style="flex-grow: 1; flex-shrink: 0; margin-left: 0; margin-right: 0; text-overflow: ellipsis; white-space: normal; min-height: 36px; margin-top: 0; margin-bottom: 0;" />
        </ui:GroupBox>
        <SpriteField name="SpriteField" style="flex-shrink: 1; flex-grow: 1; width: 25%; -unity-background-scale-mode: scale-to-fit;" />
    </ui:GroupBox>
    <ui:IntegerField label="Index" value="42" name="Field_Index" binding-path="m_SortingIndex" style="margin-top: 2px; margin-bottom: 0;" />
</ui:UXML>
